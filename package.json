{
  "name": "orbit",
  "version": "0.1.0",
  "private": true,
  "description": "Radial 'Open with' menu for Windows — drag a file, drop on an app.",
  "author": "dwimbley",
  "main": "dist/app/main/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-renderer.js",
    "start": "electron dist/app/main/index.js",
    "test": "vitest run",
    "rebuild-native": "node scripts/rebuild-native.js",
    "package": "npm run rebuild-native && npm run build && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "node-addon-api": "8.9.2",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "cmake-js": "^8.0.0",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "playwright": "^1.64.1",
    "typescript": "~5.6.0",
    "vitest": "~2.1.0"
  },
  "build": {
    "appId": "com.orbit.app",
    "productName": "Orbit",
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "dist/**/*",
      "app/renderer/**/*.html",
      "app/renderer/**/*.css",
      "app/renderer/**/*.js",
      "app/renderer/shared/**/*",
      "catalog/**/*",
      "native/filewheel-native/build/Release/*.node",
      "!node_modules/cmake-js/**",
      "!node_modules/@electron/rebuild/**",
      "!node_modules/electron/**",
      "!node_modules/electron-builder/**",
      "!node_modules/vitest/**",
      "!node_modules/typescript/**",
      "!node_modules/@types/**",
      "!**/*.ts",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "native/filewheel-native/build/Release/filewheel-native.node",
        "to": "native/filewheel-native.node"
      }
    ],
    "directories": {
      "output": "release"
    }
  }
}
